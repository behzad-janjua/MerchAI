<div class="app">

  <%# ── Header ──────────────────────────────────────────── %>
  <header class="app-header">
    <div class="brand">
      <div class="brand-mark">
        <svg viewBox="0 0 24 24">
          <path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"/>
          <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-name">MerchAI</span>
        <span class="brand-sub">Shopify listing optimizer</span>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to root_path, class: "btn btn-ghost" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px">
          <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>
        </svg>
        Refresh
      <% end %>
      <div class="header-sep"></div>
      <%= link_to new_listing_path, class: "btn btn-outline" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        New listing
      <% end %>
      <%= button_tag form: "listing-form", class: "btn btn-outline" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v14a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
        </svg>
        Save
      <% end %>
      <% if @selected_listing %>
        <%= button_to optimize_listing_path(@selected_listing["id"]), method: :post, class: "btn btn-danger" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
          Run optimizer
        <% end %>
      <% else %>
        <button class="btn btn-danger" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
          Run optimizer
        </button>
      <% end %>
    </div>
  </header>

  <%# ── Flash notices ───────────────────────────────────── %>
  <% if notice.present? || alert.present? %>
    <div class="notice-wrap">
      <% if notice.present? %><div class="notice"><%= notice %></div><% end %>
      <% if alert.present? %><div class="notice alert"><%= alert %></div><% end %>
    </div>
  <% end %>

  <%# ── Body ────────────────────────────────────────────── %>
  <div class="app-body">

    <%# ── Left: Listings + Cost ────────────────────────── %>
    <div class="col-left">
      <div class="col-section-header">
        <h2>Listings</h2>
        <span class="count-badge"><%= @listings.length %></span>
      </div>

      <div class="import-strip">
        <%= form_with url: import_listings_path, multipart: true, local: true do |form| %>
          <%= form.file_field :csv, accept: ".csv,text/csv" %>
          <%= form.submit "Import CSV", class: "btn btn-outline" %>
        <% end %>
      </div>

      <div class="listing-nav">
        <% @listings.each do |listing| %>
          <% selected = @selected_listing && listing["id"] == @selected_listing["id"] %>
          <% score = suggestion_for(listing)&.fetch("score", nil) %>
          <%= link_to listing_path(listing["id"]), class: ["listing-item", selected ? "selected" : nil].compact.join(" ") do %>
            <span class="listing-glyph"><%= listing["title"]&.first&.upcase || "?" %></span>
            <span class="listing-meta">
              <strong><%= listing["title"] %></strong>
              <small><%= listing["productType"].presence || listing["vendor"].presence || "Uncategorized" %></small>
            </span>
            <span class="score-pill <%= score_class(score) %>"><%= score || "–" %></span>
          <% end %>
        <% end %>

        <% if @listings.empty? %>
          <div class="empty">
            <div class="empty-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"/>
                <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
              </svg>
            </div>
            <strong>No listings yet</strong>
            <span>Import a CSV or create your first listing above</span>
          </div>
        <% end %>
      </div>

      <%# Cost section %>
      <div class="cost-section">
        <p class="cost-section-label">Usage & cost</p>
        <% if @cost_summary %>
          <div class="metric-grid">
            <div class="metric-card">
              <strong><%= money(@cost_summary.fetch("totalEstimatedCost", 0)) %></strong>
              <small>Total cost</small>
            </div>
            <div class="metric-card">
              <strong><%= @cost_summary.fetch("totalStepRuns", 0) %></strong>
              <small>Agent steps</small>
            </div>
          </div>
          <div class="provider-list">
            <% @cost_summary.fetch("byProviderModel", []).each do |g| %>
              <div class="provider-row">
                <div class="provider-row-info">
                  <b><%= g["provider"] %></b>
                  <small><%= g["model"] %></small>
                </div>
                <span class="provider-row-cost"><%= money(g["estimatedCost"]) %></span>
              </div>
            <% end %>
            <% if @cost_summary.fetch("byProviderModel", []).empty? %>
              <p class="muted">No runs yet.</p>
            <% end %>
          </div>
        <% else %>
          <p class="muted">Run the optimizer to track costs.</p>
        <% end %>
      </div>
    </div>

    <%# ── Center: Editor ───────────────────────────────── %>
    <div class="col-center">
      <div class="editor-wrap">
        <div class="editor-header">
          <div>
            <h1 class="editor-title">
              <%= @form["id"].present? ? (@form["title"].presence || "Untitled listing") : "New listing" %>
            </h1>
            <p class="editor-subtitle">
              <% if @form["id"].present? %>
                <%= [@form["vendor"].presence, @form["productType"].presence].compact.join(" · ").presence || "Edit product details below" %>
              <% else %>
                Fill in the details below and save to create a listing
              <% end %>
            </p>
          </div>
          <span class="editor-badge"><%= @form["id"].present? ? "Editing" : "New" %></span>
        </div>

        <%= form_with url: save_listing_path, scope: :listing, local: true, html: { id: "listing-form" } do |form| %>
          <% if @form["id"].present? %>
            <%= hidden_field_tag :id, @form["id"] %>
          <% end %>

          <div class="form-section">
            <p class="form-section-title">Identity</p>
            <div class="form-grid">
              <label class="span-2">
                <span class="field-label">Title</span>
                <%= form.text_field :title, value: @form["title"], placeholder: "e.g. Organic Cotton Tote Bag" %>
              </label>
              <label>
                <span class="field-label">Shopify product ID</span>
                <%= form.text_field :shopifyProductId, value: @form["shopifyProductId"], placeholder: "gid://shopify/…" %>
              </label>
              <label>
                <span class="field-label">Handle</span>
                <%= form.text_field :handle, value: @form["handle"], placeholder: "url-slug" %>
              </label>
            </div>
          </div>

          <div class="form-section">
            <p class="form-section-title">Categorization</p>
            <div class="form-grid">
              <label>
                <span class="field-label">Vendor</span>
                <%= form.text_field :vendor, value: @form["vendor"], placeholder: "Brand or supplier" %>
              </label>
              <label>
                <span class="field-label">Product type</span>
                <%= form.text_field :productType, value: @form["productType"], placeholder: "Apparel, Accessories…" %>
              </label>
            </div>
          </div>

          <div class="form-section">
            <p class="form-section-title">Pricing & inventory</p>
            <div class="form-grid">
              <label>
                <span class="field-label">Price</span>
                <%= form.text_field :price, value: @form["price"], inputmode: "decimal", placeholder: "0.00" %>
              </label>
              <label>
                <span class="field-label">Currency</span>
                <%= form.text_field :currency, value: @form["currency"], maxlength: 3, placeholder: "USD" %>
              </label>
              <label class="span-2">
                <span class="field-label">Inventory quantity</span>
                <%= form.text_field :inventoryQuantity, value: @form["inventoryQuantity"], inputmode: "numeric", placeholder: "0" %>
              </label>
            </div>
          </div>

          <div class="form-section">
            <p class="form-section-title">Content & SEO</p>
            <div class="form-grid single">
              <label>
                <span class="field-label">Tags <span style="font-weight:400;color:var(--gray-400)">(comma-separated)</span></span>
                <%= form.text_field :tags, value: @form["tags"], placeholder: "summer, organic, tote" %>
              </label>
              <label>
                <span class="field-label">Target audience</span>
                <%= form.text_field :audience, value: @form["audience"], placeholder: "Who is this product for?" %>
              </label>
              <label>
                <span class="field-label">Description</span>
                <%= form.text_area :description, value: @form["description"], placeholder: "Product description — the optimizer will improve this." %>
              </label>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Right: Suggestions ───────────────────────────── %>
    <div class="col-right">
      <% suggestion = suggestion_for(@selected_listing) %>
      <% score = suggestion&.fetch("score", nil) %>

      <div class="suggestion-header">
        <h2>AI Suggestion</h2>
        <span class="suggestion-score <%= score_class(score) %>"><%= score ? "#{score}/100" : "–" %></span>
      </div>

      <% if suggestion.blank? %>
        <div class="empty">
          <div class="empty-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            </svg>
          </div>
          <strong>No suggestion yet</strong>
          <span>Select a listing and run the optimizer to see AI recommendations</span>
        </div>
      <% else %>

        <% if @agent_run && @agent_run.fetch("steps", []).any? %>
          <div class="suggestion-section">
            <p class="suggestion-label">Agent steps</p>
            <div class="step-list">
              <% @agent_run.fetch("steps", []).each do |step| %>
                <details class="step-item" <%= "open" if step["stepName"] == "final_synthesis" %>>
                  <summary>
                    <span><%= step_name(step["stepName"]) %></span>
                    <small><%= money(step["estimatedCost"]) %></small>
                  </summary>
                  <div class="step-body">
                    <p><%= step["response"].presence || step["errorMessage"].presence || "No response recorded." %></p>
                    <p class="step-meta">
                      <%= step["provider"].presence || "unknown" %> / <%= step["model"].presence || "unknown" %>
                      &middot; <%= step["inputTokens"].to_i + step["outputTokens"].to_i %> tokens
                    </p>
                  </div>
                </details>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="suggestion-section">
          <p class="suggestion-label">Improved title</p>
          <p class="suggestion-text"><%= suggestion["improvedTitle"].presence || @selected_listing["title"] %></p>
        </div>

        <div class="suggestion-section">
          <p class="suggestion-label">Improved description</p>
          <p class="suggestion-text"><%= suggestion["improvedDescription"] %></p>
        </div>

        <div class="suggestion-section">
          <p class="suggestion-label">Tags</p>
          <div class="tag-wrap">
            <% suggestion.fetch("tags", []).each do |tag| %>
              <span class="tag"><%= tag %></span>
            <% end %>
          </div>
        </div>

        <div class="suggestion-section">
          <p class="suggestion-label">Positioning</p>
          <p class="suggestion-text"><%= suggestion["positioningRecommendations"] %></p>
        </div>

        <div class="suggestion-section">
          <p class="suggestion-label">SEO notes</p>
          <p class="suggestion-text"><%= suggestion["seoNotes"] %></p>
        </div>

      <% end %>
    </div>

  </div><%# /app-body %>
</div><%# /app %>
