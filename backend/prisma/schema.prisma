generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model ProductListing {
  id                 String                   @id @default(cuid())
  shopifyProductId   String?                  @unique
  title              String
  handle             String?
  vendor             String?
  productType        String?
  description        String?
  tags               String[]                 @default([])
  price              Decimal?                 @db.Decimal(10, 2)
  currency           String                   @default("USD")
  inventoryQuantity  Int?
  rawData            Json                     @default("{}")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  agentRuns          AgentRun[]
  suggestions        OptimizationSuggestion[]

  @@index([handle])
  @@index([updatedAt])
}

model AgentRun {
  id               String                  @id @default(cuid())
  productListingId String
  status           AgentRunStatus          @default(QUEUED)
  startedAt        DateTime?
  completedAt      DateTime?
  errorMessage     String?
  analysis         Json                    @default("{}")
  metadata         Json                    @default("{}")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  productListing   ProductListing          @relation(fields: [productListingId], references: [id], onDelete: Cascade)
  suggestion       OptimizationSuggestion?
  steps            AgentStepRun[]

  @@index([productListingId, createdAt])
}

model AgentStepRun {
  id            String         @id @default(cuid())
  agentRunId    String
  stepName      String
  stepOrder     Int
  prompt        String         @db.Text
  response      String?        @db.Text
  provider      String?
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Decimal?       @db.Decimal(10, 6)
  status        AgentRunStatus @default(QUEUED)
  errorMessage  String?
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  agentRun      AgentRun       @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId, stepOrder])
  @@index([provider, model])
}

model LlmProviderConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  provider        String
  displayName     String
  baseUrl         String?
  apiKeyEnvVar    String?
  model           String
  inputCostPer1K  Decimal  @default(0) @db.Decimal(10, 6)
  outputCostPer1K Decimal  @default(0) @db.Decimal(10, 6)
  enabled         Boolean  @default(true)
  isDefault       Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, isDefault])
  @@index([provider, model])
}

model OptimizationSuggestion {
  id                         String         @id @default(cuid())
  productListingId           String
  agentRunId                 String         @unique
  improvedTitle              String?
  improvedDescription        String
  tags                       String[]       @default([])
  positioningRecommendations String?
  seoNotes                   String?
  score                      Decimal?       @db.Decimal(5, 2)
  rationale                  String?
  accepted                   Boolean        @default(false)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  productListing             ProductListing @relation(fields: [productListingId], references: [id], onDelete: Cascade)
  agentRun                   AgentRun       @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([productListingId, createdAt])
}
